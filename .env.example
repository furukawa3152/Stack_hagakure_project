# コピーして .env にする。値は Git に入れない。
# 空の HAGAKURE_DEVICE_TOKEN は 127.0.0.1 だけを許す。LAN に出すときは必ずトークンを入れる。

HAGAKURE_HOST=127.0.0.1
HAGAKURE_PORT=8775
HAGAKURE_PREVIEW_PORT=8776
HAGAKURE_DEVICE_TOKEN=

# echo はマイクをそのまま返す。gemini は発話の終わりで Gemini Live に渡す。
HAGAKURE_VOICE=echo
HAGAKURE_SAVE_TRANSCRIPTS=0

# 空のままでは Gemini Live を呼ばない。値は Git に入れない。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-live

# Grok Bot 連携は保留。資格情報はここに置かない。
# 連携するときは Mac 上の gbot / ローカル転送先だけを指す。
HAGAKURE_GBOT_URL=http://127.0.0.1:18770
HAGAKURE_TOOL_BOT=
